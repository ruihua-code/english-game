{
  "name": "grammar-quest-electron",
  "version": "0.1.1",
  "private": true,
  "description": "Grade 7 English grammar quest desktop app built with Electron + React.",
  "main": "electron/main.js",
  "type": "module",
  "author": "developer",
  "scripts": {
    "dev": "concurrently -k \"npm run dev:vite\" \"npm run dev:electron\"",
    "dev:vite": "vite",
    "dev:electron": "wait-on http://localhost:5173 && electron .",
    "build": "vite build && electron-builder",
    "dist:win": "npm run build -- --win",
    "dist:mac": "npm run build -- --mac",
    "dist:all": "npm run build -- --mac --win",
    "start": "npm run dev"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.0.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "vite": "^5.4.0",
    "wait-on": "^8.0.0"
  },
  "build": {
    "appId": "com.example.grammarquest",
    "productName": "语法闯关",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "asar": true,
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    },
    "publish": []
  }
}
